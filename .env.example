# ---------------------------------------------------------------------------
# Dropship Command Center — environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored and must NEVER be committed. Secrets live here or in the
# DB (encrypted) — never in code (CLAUDE.md rule 2).
#
# The DATABASE_URL / REDIS_URL defaults below match docker-compose.yml, so with
# `docker compose up -d` running, the app works against local infra unchanged.
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma at runtime.
# Local Docker default below (matches docker-compose.yml). For managed Postgres
# (e.g. Neon), use the POOLED connection string and append &pgbouncer=true.
DATABASE_URL="postgresql://dropship:dropship@localhost:5432/dropship?schema=public"

# Direct (non-pooled) Postgres connection. Prisma uses this for migrations,
# which can't run through a connection pooler (PgBouncer). With local Docker
# it's the same as DATABASE_URL; with Neon it's the host WITHOUT "-pooler".
DIRECT_URL="postgresql://dropship:dropship@localhost:5432/dropship?schema=public"

# Redis connection string used by BullMQ (queues + workers).
# Matches the redis service in docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# AES-256-GCM key for encrypting Shopify access tokens / supplier API keys at
# rest (CLAUDE.md rule 2; used by lib/crypto.ts in task 1.1). AES-256 requires
# a 32-byte key, supplied here as 64 hex characters.
# Generate one:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Anthropic API key for product scoring, copy generation, and weekly reviews.
# Get one at https://console.anthropic.com/ (starts with "sk-ant-").
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used for AI features (lib/ai/constants.ts).
# Defaults to claude-sonnet-4-6 (good judgment, low cost for per-item scoring).
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Secret used by NextAuth v5 (Auth.js) to sign/encrypt session JWTs (task 0.3).
# NOTE: v5 reads AUTH_SECRET (not NEXTAUTH_SECRET). Generate one:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Single-owner login (task 0.3). The one account is defined entirely by env —
# there is no users table. AUTH_USER_PASSWORD_HASH is a scrypt "salt:derivedKey"
# (hex) produced by lib/auth/password.ts. Generate a hash for a chosen password:
#     node -e "const{randomBytes,scryptSync}=require('node:crypto');const pw=process.argv[1];const s=randomBytes(16).toString('hex');console.log(s+':'+scryptSync(pw,s,64).toString('hex'))" "your-password"
AUTH_USER_EMAIL=""
AUTH_USER_PASSWORD_HASH=""

# Base URL NextAuth uses for callbacks. Optional for local dev (defaults to
# http://localhost:3000); set explicitly in production to your real domain.
NEXTAUTH_URL="http://localhost:3000"

# Shopify webhook signing secret (task 2.1). The /api/webhooks/shopify endpoint
# verifies HMAC-SHA256 of the raw body against this. In production, use the
# app's webhook signing secret from the Shopify admin / API credentials.
SHOPIFY_WEBHOOK_SECRET=""

# Public base URL of this app (task 2.2). Used to build the webhook callback URL
# registered with Shopify. Must be the real https domain in production; Shopify
# rejects non-public URLs, so webhook registration only works once deployed.
APP_URL="http://localhost:3000"

# Margin guardrails (task 2.4). The 4-hourly sweep alerts when a supplier-linked
# product's margin drops below GUARDRAIL_MARGIN_FLOOR_PCT, suggesting a reprice
# of COGS × GUARDRAIL_REPRICE_MULTIPLIER. Both optional (defaults 25 and 3).
GUARDRAIL_MARGIN_FLOOR_PCT="25"
GUARDRAIL_REPRICE_MULTIPLIER="3"

# Alert email notifications (task 2.5). Optional: if RESEND_API_KEY and
# ALERT_EMAIL_TO are set, alerts of severity HIGH/CRITICAL are emailed via
# Resend. Without them, alerts still appear in the UI (email just no-ops).
# ALERT_EMAIL_FROM must be a Resend-verified sender (defaults to the test sender).
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="onboarding@resend.dev"
